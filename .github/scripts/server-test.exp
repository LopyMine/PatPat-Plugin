#!/usr/bin/expect

spawn ./start.sh
set timeout 90

expect {
    -exact { INFO]: Done } {
        puts "Server loaded"
        send "patpat info\n"
        expect {
            -exact {[PatPat] Platform: } {
                exit 0
            }
            timeout
            eof {
                puts "ERROR: server is not launched"
                exit 1
            }
        }
    }
    timeout
    eof {
      puts "ERROR: server is not launched"
        exit 1
    }
}
